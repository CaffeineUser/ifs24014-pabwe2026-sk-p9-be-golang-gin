    "definitions": {
        "ai.GenerateRequest": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string",
                    "example": "Pendidikan"
                },
                "include_web_search": {
                    "type": "boolean",
                    "example": true
                },
                "topic": {
                    "type": "string",
                    "example": "Dampak AI pada pendidikan tinggi di Indonesia"
                }
            }
        },
        "auth.LoginRequest": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string",
                    "example": "rahasia123"
                },
                "username": {
                    "type": "string",
                    "example": "budi_santoso"
                }
            }
        },
        "auth.RegisterRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "budi@example.com"
                },
                "password": {
                    "type": "string",
                    "example": "rahasia123"
                },
                "username": {
                    "type": "string",
                    "example": "budi_santoso"
                }
            }
        },
        "auth.UpdateProfileRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "budi.baru@example.com"
                },
                "username": {
                    "type": "string",
                    "example": "budi_baru"
                }
            }
        },
        "post.PostRequest": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string",
                    "example": "Teknologi"
                },
                "content": {
                    "type": "string",
                    "example": "Isi artikel dalam format Markdown."
                },
                "cover_image_path": {
                    "type": "string",
                    "example": "https://example.com/cover.jpg"
                },
                "excerpt": {
                    "type": "string",
                    "example": "Ringkasan singkat artikel."
                },
                "title": {
                    "type": "string",
                    "example": "Belajar Golang dengan Gin"
                }
            }
        },
        "response.Body": {
            "type": "object",
            "properties": {
                "data": {},
                "message": {
                    "type": "string",
                    "example": "Operasi berhasil"
                },
                "status": {
                    "type": "string",
                    "example": "success"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Isi dengan: Bearer {token JWT} (kata Bearer, spasi, lalu token dari /auth/login)",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
